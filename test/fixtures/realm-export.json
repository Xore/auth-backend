{
  "realm": "test-apiary",
  "enabled": true,
  "displayName": "APIARY",
  "loginTheme": "apiary",
  "accountTheme": "apiary",
  "adminTheme": "keycloak.v2",
  "emailTheme": "apiary",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "editUsernameAllowed": false,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "otpPolicyCodeReusable": false,
  "sslRequired": "none",
  "smtpServer": {
    "host": "mailhog",
    "port": "1025",
    "from": "no-reply@apiary.test",
    "fromDisplayName": "APIARY (test)",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 15
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 20
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 30
    },
    {
      "alias": "webauthn-register",
      "name": "Webauthn Register",
      "providerId": "webauthn-register",
      "enabled": true,
      "defaultAction": false,
      "priority": 40
    },
    {
      "alias": "webauthn-register-passwordless",
      "name": "Webauthn Register Passwordless",
      "providerId": "webauthn-register-passwordless",
      "enabled": true,
      "defaultAction": false,
      "priority": 50
    }
  ],
  "clients": [
    {
      "clientId": "theme-test-client",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "consentRequired": false,
      "redirectUris": ["http://localhost:8180/realms/test-apiary/theme-test-landing*"],
      "webOrigins": ["http://localhost:8180"],
      "attributes": {
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "theme-test-consent-client",
      "name": "Theme Test Consent Client",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "consentRequired": true,
      "redirectUris": ["http://localhost:8180/realms/test-apiary/theme-test-landing*"],
      "webOrigins": ["http://localhost:8180"]
    },
    {
      "clientId": "theme-test-device-client",
      "name": "Theme Test Device Client",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "consentRequired": false,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true"
      }
    }
  ],
  "users": [
    {
      "username": "test-user-no-totp",
      "enabled": true,
      "email": "test-user-no-totp@example.invalid",
      "emailVerified": true,
      "credentials": [
        {"type": "password", "value": "test-password-only", "temporary": false}
      ],
      "requiredActions": ["CONFIGURE_TOTP"]
    },
    {
      "username": "test-user-verify-email",
      "enabled": true,
      "email": "test-user-verify-email@example.invalid",
      "emailVerified": false,
      "credentials": [
        {"type": "password", "value": "test-password-only", "temporary": false}
      ],
      "requiredActions": ["VERIFY_EMAIL"]
    },
    {
      "username": "test-user-webauthn-register",
      "enabled": true,
      "email": "test-user-webauthn-register@example.invalid",
      "emailVerified": true,
      "credentials": [
        {"type": "password", "value": "test-password-only", "temporary": false}
      ],
      "requiredActions": ["webauthn-register"]
    },
    {
      "username": "test-user-consent",
      "enabled": true,
      "email": "test-user-consent@example.invalid",
      "emailVerified": true,
      "credentials": [
        {"type": "password", "value": "test-password-only", "temporary": false}
      ],
      "requiredActions": []
    },
    {
      "username": "test-user-multi-factor",
      "enabled": true,
      "email": "test-user-multi-factor@example.invalid",
      "emailVerified": true,
      "credentials": [
        {"type": "password", "value": "test-password-only", "temporary": false}
      ],
      "requiredActions": ["CONFIGURE_TOTP", "webauthn-register"]
    },
    {
      "username": "test-user-multi-factor-2",
      "enabled": true,
      "email": "test-user-multi-factor-2@example.invalid",
      "emailVerified": true,
      "credentials": [
        {"type": "password", "value": "test-password-only", "temporary": false}
      ],
      "requiredActions": ["CONFIGURE_TOTP", "webauthn-register"]
    }
  ]
}
