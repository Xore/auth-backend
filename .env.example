# Copy to .env in the repo root and fill in the values.
# docker-compose automatically loads .env from the same directory.

AUTH_HOST=auth.xore.rocks
COOKIE_DOMAIN=.xore.rocks
COOKIE_NAME=xore_sso
# Compile-time identifier shown in Administration → System.
VERSION=dev

# openssl rand -hex 32 — keep stable across restarts/replicas
COOKIE_SECRET=<REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS>
# During a cookie-key rotation, put the former key here (comma-separated if
# necessary). Remove it after every old session has expired.
COOKIE_SECRET_PREVIOUS=
# PASETO v4.local session key — required, exactly 64 hex chars (32 bytes):
#   openssl rand -hex 32
PASETO_KEY=<REPLACE_WITH_STRONG_RANDOM_64_HEX_CHARS>
# During a PASETO key rotation, put the former key(s) here (comma-separated
# 64-hex values). Tokens verified with them are transparently re-issued under
# the current key. Remove after every old session has expired.
PASETO_KEY_PREVIOUS=

AUTH_USERNAME=admin
# Bootstraps the initial admin only — ignored once users.json is non-empty.
AUTH_PASSWORD=<REPLACE_WITH_STRONG_ADMIN_PASSWORD>

# Optional bootstrap TOTP secret for the initial admin. A logged-in user can
# enroll or replace TOTP at https://<AUTH_HOST>/_auth/enroll instead.
TOTP_SECRET=
TOTP_ISSUER=auth.xore.rocks
REQUIRE_TOTP=true
# Passkey-only mode: disables the password login path and email recovery;
# sign-in happens exclusively via WebAuthn/passkeys.
PASSWORDLESS=false
TRUST_DEVICE_DAYS=0
# Optional comma-separated proxy CIDRs trusted to set client-IP headers.
TRUSTED_PROXIES=

SESSION_TTL_HOURS=12
# Idle sessions (no activity seen) are revoked after this many minutes; 0 disables.
IDLE_TIMEOUT_MINUTES=60
MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
MIN_DWELL_SECONDS=2
FORM_TTL_MINUTES=15
COOKIE_SECURE=true
MAX_BODY_KB=64

# Optional alert webhook and bearer token for /_auth/metrics.
# Must be https:// — alert payloads contain user and IP data.
WEBHOOK_URL=
# Payload format for the webhook: raw (default), slack, ntfy or gotify.
WEBHOOK_PROVIDER=raw
METRICS_TOKEN=<REPLACE_WITH_METRICS_BEARER_TOKEN_OR_LEAVE_BLANK_TO_DISABLE>
# Shared only with protected backends that perform live session introspection.
# Generate with: openssl rand -hex 32
AUTH_INTROSPECTION_TOKEN=<REPLACE_WITH_STRONG_RANDOM_64_HEX_CHARS>

# Optional: URL of your SAML/OIDC IdP. When set, the login page shows a
# "Continue with SSO" button that redirects here (rd is passed through).
SSO_URL=
# Optional: SMTP for email-based password recovery at /_auth/recover.
# smtps://user:pass@host:465 (implicit TLS, TLS 1.2+) or
# smtp://[user:pass@]host:587 (STARTTLS required, TLS 1.2+). Recovery mail
# is sent to the user's validated Email field (admin panel) or, for older
# accounts, to an email-shaped username. Leave blank to disable recovery
# (route 404s).
SMTP_URL=
SMTP_FROM=
# Development ONLY: allow smtp:// without STARTTLS, sending credentials and
# reset links over plaintext. Defaults to false; never set in production.
SMTP_ALLOW_INSECURE=false
# The bundled Compose stack starts a private, persistent Redis service.
# REDIS_PASSWORD is required by Compose. Leave REDIS_URL blank to use it,
# or set redis://[:password@]host:6379/0 for an external Redis backend.
# Startup fails if the selected Redis service is unreachable.
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=replace-with-64-hex-characters
REDIS_URL=
# Optional: organization identifier shown on the admin System pane.
ORG_ID=

# Set to a non-empty value to confirm the auth-credentials-reset maintenance
# profile (see docs/CREDENTIAL-RECOVERY.md). Leave blank otherwise.
AUTH_RESET_CONFIRM=
